# Copy this file to .env.runtime on the server and set strong values.
# Do not commit .env.runtime to git.

POSTGRES_DB=my_cube

# Postgres bootstrap superuser used by db container.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=replace_with_long_random_superuser_password

# Least-privilege app user used by Django.
APP_POSTGRES_USER=mycube_app
APP_POSTGRES_PASSWORD=replace_with_long_random_app_password

# Existing app settings (set strong values in production).
METRICS_BEARER_TOKEN=replace_with_long_random_metrics_token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_long_random_grafana_password
